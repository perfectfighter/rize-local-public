{
  "name": "rize-local",
  "productName": "Rize Local",
  "version": "1.2.0",
  "description": "Independent local Windows time-tracking desktop recreation",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test",
    "package:windows": "node scripts/package-windows.mjs",
    "server": "node server/index.cjs",
    "mcp": "node server/mcp.cjs",
    "package:installer": "electron-builder --win nsis --x64 --publish never",
    "release:windows": "node scripts/release-windows.mjs"
  },
  "dependencies": {
    "@fontsource/lato": "5.3.0",
    "@paymoapp/active-window": "2.2.0",
    "electron-updater": "6.8.9",
    "node-ical": "0.27.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-feather": "2.0.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "linkedom": "0.18.13",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "build": {
    "appId": "io.rizelocal.desktop",
    "productName": "Rize Local",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "native/**",
      "package.json",
      "THIRD-PARTY-NOTICES.md",
      "docs/licenses/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@paymoapp/active-window/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Rize-Local-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "perfectfighter",
        "repo": "rize-local-public",
        "releaseType": "release"
      }
    ]
  }
}
